<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.nightly-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/PATH/TO/automation/nightly_report.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <!-- ВАЖНО: пути логов — в НЕзащищённую папку, иначе при падении не увидите даже причину (TCC) -->
  <key>StandardOutPath</key>
  <string>/tmp/nightly_report_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nightly_report_stderr.log</string>
</dict>
</plist>
